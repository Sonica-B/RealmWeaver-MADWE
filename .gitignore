.env
*.pyc


# ========================================
# Data & Models
# ========================================
# Keep folder structure but ignore large files
data/raw/**/*.png
data/raw/**/*.jpg
data/raw/**/*.jpeg
data/processed/**/*.png
data/processed/**/*.jpg
data/samples/**/*.png
data/samples/**/*.jpg
data/chroma/
!data/**/.gitkeep
*.h5
*.pkl
*.npy
*.npz

# Model files
*.pth
*.pt
*.onnx
*.trt
*.safetensors
data/models/checkpoints/
data/models/final/
!data/models/.gitkeep

# ========================================
# Logs & Outputs
# ========================================
logs/
*.log
wandb/
outputs/
agent_states/

# ========================================
# Unity Project
# ========================================
# Ignore Unity generated folders (large files)
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Unity specific ignores
*.pidb
*.suo
*.tmp
*.user
*.userprefs
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity generated meta files for folders
*.meta
!*.*.meta

# Unity crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# ========================================
# INCLUDE Unity Project Files (Important!)
# ========================================
# Include all Unity assets and scripts
!unity_project/
!unity_project/Assets/
!unity_project/Assets/**
!unity_project/ProjectSettings/
!unity_project/ProjectSettings/**
!unity_project/Packages/
!unity_project/Packages/**

# Include meta files for assets
!unity_project/Assets/**/*.meta
!unity_project/ProjectSettings/*.asset

# ========================================
# IDE & Editors
# ========================================
.vscode/
.idea/
*.swp
*.swo
*~
.vs/
*.csproj
*.sln
*.sublime-project
*.sublime-workspace

# ========================================
# OS Files
# ========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

