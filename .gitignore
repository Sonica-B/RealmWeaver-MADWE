*.tmp
*.bak
*.swp
*~.nib
*.orig

# ========================================
# Project Specific
# ========================================
# StreamingAssets textures (generated)
unity_project/Assets/StreamingAssets/Textures/**/*.png
unity_project/Assets/StreamingAssets/Textures/**/*.jpg
!unity_project/Assets/StreamingAssets/Textures/**/.gitkeep

# Keep important project files
!requirements.txt
!setup.py
!README.md
!.gitignore